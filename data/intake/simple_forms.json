{
  "schema": "tpw.simple/1",
  "note": "The quick forms. Deliberately small: one screen each. Read by intake/js/simple.js and scripts/intake_simple.py.",
  "forms": [
    {
      "kind": "weekly",
      "label": "Weekly",
      "title": "How did this week go?",
      "blurb": "About twenty seconds. One entry per program per week.",
      "submit": "Log the week",
      "fields": [
        {
          "key": "program",
          "label": "Program",
          "type": "text",
          "required": true,
          "datalist": "programs",
          "placeholder": "Guiding Rage Into Power"
        },
        {
          "key": "facility",
          "label": "Facility",
          "type": "facility",
          "required": true
        },
        {
          "key": "week_ending",
          "label": "Week ending",
          "type": "date",
          "required": true
        },
        {
          "key": "sessions",
          "label": "Sessions held",
          "type": "integer",
          "required": true,
          "min": 0,
          "max": 40,
          "half": true
        },
        {
          "key": "attendance",
          "label": "People at sessions",
          "type": "integer",
          "required": true,
          "min": 0,
          "max": 2000,
          "half": true,
          "help": "Total attendances, not unique people."
        },
        {
          "key": "notes",
          "label": "Anything to flag?",
          "type": "textarea",
          "max": 400,
          "placeholder": "Yard locked down Wednesday; made up the session Friday."
        }
      ]
    },
    {
      "kind": "aggregate",
      "label": "Quarter",
      "title": "Quarterly totals",
      "blurb": "For an organization that counts its own numbers. One row per program per quarter.",
      "submit": "Add the quarter",
      "fields": [
        {
          "key": "org",
          "label": "Organization",
          "type": "text",
          "required": true,
          "datalist": "orgs",
          "placeholder": "Defy Ventures"
        },
        {
          "key": "program",
          "label": "Program",
          "type": "text",
          "required": true,
          "datalist": "programs",
          "placeholder": "CEO of Your New Life"
        },
        {
          "key": "facility",
          "label": "Facility",
          "type": "facility",
          "required": true
        },
        {
          "key": "quarter",
          "label": "Quarter",
          "type": "select",
          "required": true,
          "options": [
            "2025-Q1",
            "2025-Q2",
            "2025-Q3",
            "2025-Q4",
            "2026-Q1",
            "2026-Q2",
            "2026-Q3",
            "2026-Q4",
            "2027-Q1",
            "2027-Q2",
            "2027-Q3",
            "2027-Q4"
          ],
          "half": true
        },
        {
          "key": "served",
          "label": "People served",
          "type": "integer",
          "required": true,
          "min": 0,
          "max": 20000,
          "half": true
        },
        {
          "key": "completed",
          "label": "People who completed",
          "type": "integer",
          "required": true,
          "min": 0,
          "max": 20000,
          "half": true
        },
        {
          "key": "sessions_held",
          "label": "Sessions held",
          "type": "integer",
          "min": 0,
          "max": 500,
          "half": true
        },
        {
          "key": "attendance",
          "label": "Total attendances",
          "type": "integer",
          "min": 0,
          "max": 100000,
          "half": true,
          "help": "Everyone at every session, counted each time."
        },
        {
          "key": "notes",
          "label": "Anything to flag?",
          "type": "textarea",
          "max": 400
        }
      ]
    },
    {
      "kind": "followup",
      "label": "Follow-up",
      "title": "What happened after release?",
      "blurb": "One participant, one outcome, whenever you hear it.",
      "submit": "Record it",
      "fields": [
        {
          "key": "token",
          "label": "Participant ID",
          "type": "text",
          "required": true,
          "placeholder": "M78 \u2014 first initial + birth year",
          "max": 12,
          "help": "The same ID that is on their session sheets."
        },
        {
          "key": "release_date",
          "label": "Released on",
          "type": "date",
          "required": true
        },
        {
          "key": "status",
          "label": "Since release",
          "type": "choice",
          "required": true,
          "options": [
            {
              "value": "no_new_conviction",
              "label": "No new conviction"
            },
            {
              "value": "new_conviction",
              "label": "New conviction"
            },
            {
              "value": "unknown",
              "label": "Don't know"
            }
          ]
        },
        {
          "key": "days",
          "label": "Days after release until conviction",
          "type": "integer",
          "min": 0,
          "max": 3650,
          "show_if": {
            "status": "new_conviction"
          }
        },
        {
          "key": "notes",
          "label": "Anything to flag?",
          "type": "textarea",
          "max": 400
        }
      ]
    },
    {
      "kind": "session",
      "label": "Session",
      "hidden": true,
      "title": "One session",
      "blurb": "Created by the sheet scanner: one page, one session, a count of ticked rows.",
      "submit": "File session",
      "fields": [
        {
          "key": "org",
          "label": "Organization",
          "type": "text",
          "max": 120
        },
        {
          "key": "program",
          "label": "Program",
          "type": "text",
          "required": true,
          "max": 120
        },
        {
          "key": "facility",
          "label": "Facility",
          "type": "facility",
          "required": true
        },
        {
          "key": "session_date",
          "label": "Session date",
          "type": "date",
          "required": true
        },
        {
          "key": "session_no",
          "label": "Session number",
          "type": "integer",
          "min": 1,
          "max": 99
        },
        {
          "key": "present_count",
          "label": "Present",
          "type": "integer",
          "required": true,
          "min": 0,
          "max": 60
        },
        {
          "key": "walkins",
          "label": "Walk-ins",
          "type": "integer",
          "min": 0,
          "max": 60
        },
        {
          "key": "sheet",
          "label": "Sheet code",
          "type": "text",
          "max": 16
        },
        {
          "key": "roster",
          "label": "Roster IDs",
          "type": "list",
          "max_items": 60,
          "max_length": 12
        },
        {
          "key": "present",
          "label": "Present IDs",
          "type": "list",
          "max_items": 60,
          "max_length": 12
        },
        {
          "key": "roster_size",
          "label": "Roster size",
          "type": "integer",
          "min": 0,
          "max": 60
        },
        {
          "key": "checked_count",
          "label": "Rows ticked",
          "type": "integer",
          "min": 0,
          "max": 60
        },
        {
          "key": "notes",
          "label": "Notes",
          "type": "textarea",
          "max": 400
        }
      ]
    }
  ]
}
