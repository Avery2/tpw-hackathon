{
  "dependencies": {
    "@neon/config": "^1.10.0",
    "@neon/env": "^1.6.8",
    "@vercel/functions": "^3.6.1",
    "pg": "^8.23.1"
  },
  "name": "tpw-demo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-neon-app.mjs",
    "dev": "node --env-file-if-exists=.env.local --env-file-if-exists=.env server/local.js",
    "start": "npm run dev",
    "db:migrate": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/neon-migrate.mjs",
    "db:import-demo": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/neon-import-demo.mjs",
    "test:neon": "node --test test/neon/*.test.mjs"
  },
  "engines": {
    "node": ">=22.16"
  }
}
