{
  "dependencies": {
    "@neon/config": "^1.10.0",
    "@neon/env": "^1.6.8",
    "@vercel/functions": "^3.6.1",
    "better-auth": "^1.7.25",
    "next": "^16.4.6",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0"
  },
  "name": "tpw-demo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-neon-app.mjs && next build",
    "dev": "node scripts/build-neon-app.mjs && next dev --hostname 127.0.0.1",
    "start": "next start",
    "db:migrate": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/neon-migrate.mjs",
    "db:import-demo": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/neon-import-demo.mjs",
    "test:neon": "node --test test/neon/*.test.mjs",
    "test:browser": "node test/browser/next-workspace.mjs",
    "db:auth-setup": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/auth-setup.mjs"
  },
  "engines": {
    "node": ">=22.16"
  },
  "devDependencies": {
    "playwright": "^1.65.1"
  }
}
